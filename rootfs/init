#!/bin/sh

export PATH=/bin:/sbin:/usr/bin:/usr/sbin

# Render Centered Boot Splash Screen with animation
clear 2>/dev/null || printf "\033[2J\033[H"
printf "\n\n\n\n\n\n\n\n"
printf "                               \033[1;36mAlpine Linux\033[0m\n"
printf "                                 Loading...\n"

for frame in '|' '/' '-' '\\' '|' '/' '-' '\\' 'OK!'; do
    printf "                                 \033[1;33m[ %s ]\033[0m\r" "$frame"
    sleep 0.2 2>/dev/null || true
done
printf "\n\n"
clear

# Mount essential virtual filesystems
mount -t proc none /proc 2>/dev/null
mount -t sysfs none /sys 2>/dev/null
mount -t devtmpfs none /dev 2>/dev/null
mkdir -p /dev/pts /tmp /etc
mount -t devpts none /dev/pts 2>/dev/null
mount -t tmpfs none /tmp 2>/dev/null

# Set hostname
hostname nano-alpine 2>/dev/null

# Initialize loopback interface
ifconfig lo 127.0.0.1 up 2>/dev/null || ip link set lo up 2>/dev/null

# Initialize network interface eth0 in background/quiet mode for QEMU / VMs
(
    ifconfig eth0 up 2>/dev/null || ip link set eth0 up 2>/dev/null
    udhcpc -i eth0 -n -q -t 3 2>/dev/null || {
        # Fallback to standard QEMU SLIRP network configuration
        ifconfig eth0 10.0.2.15 netmask 255.255.255.0 up 2>/dev/null
        route add default gw 10.0.2.2 2>/dev/null
    }
) &

# Loop shell on controlling tty and fallback to tty0 for VGA graphical display
while true; do
    if [ -x /bin/cttyhack ]; then
        /bin/cttyhack /bin/sh 2>/dev/null || /bin/sh < /dev/tty0 > /dev/tty0 2>&1 || /bin/sh
    else
        /bin/sh < /dev/tty0 > /dev/tty0 2>&1 || /bin/sh
    fi
    echo "Shell exited, restarting in 1 sec..."
    sleep 1
done
