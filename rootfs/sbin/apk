#!/bin/sh
# Zero-dependency APK package manager for Alpine Linux

DB_DIR="/var/lib/apk_mini"
DB_INSTALLED="$DB_DIR/installed"
MIRROR_BASE="http://dl-cdn.alpinelinux.org/alpine/v3.20"
ARCH="x86_64"

mkdir -p "$DB_DIR" /tmp 2>/dev/null
touch "$DB_INSTALLED" 2>/dev/null

usage() {
    echo "Usage: apk <add|del|list> [package_name]"
    exit 1
}

fetch_index() {
    if [ ! -f /tmp/APKINDEX_main ] || [ ! -f /tmp/APKINDEX_comm ]; then
        echo "Updating package index..."
        wget -qO- "$MIRROR_BASE/main/$ARCH/APKINDEX.tar.gz" | tar -xz -C /tmp 2>/dev/null && mv /tmp/APKINDEX /tmp/APKINDEX_main 2>/dev/null
        wget -qO- "$MIRROR_BASE/community/$ARCH/APKINDEX.tar.gz" | tar -xz -C /tmp 2>/dev/null && mv /tmp/APKINDEX /tmp/APKINDEX_comm 2>/dev/null
    fi
}

case "$1" in
    add)
        PKG="$2"
        if [ -z "$PKG" ]; then usage; fi

        if [ -f "$PKG" ]; then
            echo "Installing local package $PKG..."
            tar -xzf "$PKG" -C / 2>/dev/null || tar -xf "$PKG" -C / 2>/dev/null
            echo "$PKG" >> "$DB_INSTALLED"
            echo "Successfully installed $PKG!"
            exit 0
        fi

        fetch_index

        REPO=""
        VER=$(awk -v pkg="$PKG" '$0=="P:"pkg {found=1; next} found && /^V:/ {sub(/^V:/,""); print $0; exit}' /tmp/APKINDEX_comm)
        if [ -n "$VER" ]; then
            REPO="community"
        else
            VER=$(awk -v pkg="$PKG" '$0=="P:"pkg {found=1; next} found && /^V:/ {sub(/^V:/,""); print $0; exit}' /tmp/APKINDEX_main)
            if [ -n "$VER" ]; then REPO="main"; fi
        fi

        if [ -z "$VER" ]; then
            echo "Error: Package '$PKG' not found in Alpine repositories."
            exit 1
        fi

        URL="$MIRROR_BASE/$REPO/$ARCH/${PKG}-${VER}.apk"
        echo "Downloading & installing $PKG ($VER)..."

        wget -qO /tmp/pkg.tar.gz "$URL"
        if [ $? -eq 0 ]; then
            tar -xzf /tmp/pkg.tar.gz -C / 2>/dev/null
            rm -f /tmp/pkg.tar.gz
            grep -q "^$PKG$" "$DB_INSTALLED" 2>/dev/null || echo "$PKG" >> "$DB_INSTALLED"
            echo "Successfully installed $PKG ($VER)!"
        else
            echo "Error: Failed to download $PKG from $URL"
            exit 1
        fi
        ;;

    del|remove)
        PKG="$2"
        if [ -z "$PKG" ]; then usage; fi
        echo "Removing $PKG..."
        sed -i "/^$PKG$/d" "$DB_INSTALLED" 2>/dev/null
        echo "Removed $PKG."
        ;;

    list)
        echo "Installed packages:"
        if [ -s "$DB_INSTALLED" ]; then
            cat "$DB_INSTALLED"
        else
            echo " (none)"
        fi
        ;;

    *)
        usage
        ;;
esac
